{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "builtin",
    "source": "arch",
    "padding": {
      "top": 1,
      "right": 3
    }
  },

  "display": {
    "separator": "  ",
    "color": {
      "keys": "magenta",
      "title": "cyan"
    }
  },

  "modules": [
    "title",

    {
      "type": "os",
      "key": "OS",
      "keyColor": "blue"
    },

    {
      "type": "host",
      "key": "Host"
    },

    {
      "type": "kernel",
      "key": "Kernel"
    },

    {
      "type": "uptime",
      "key": "Uptime"
    },

    {
      "type": "packages",
      "key": "Packages"
    },

    {
      "type": "shell",
      "key": "Shell"
    },

    {
      "type": "display",
      "key": "Resolution"
    },

    {
      "type": "wm",
      "key": "WM"
    },

    {
      "type": "wmtheme",
      "key": "Theme"
    },

    {
      "type": "terminal",
      "key": "Terminal"
    },

    {
      "type": "cpu",
      "key": "CPU"
    },

    {
      "type": "gpu",
      "key": "GPU"
    },

    {
      "type": "memory",
      "key": "Memory"
    },

    {
      "type": "disk",
      "key": "Disk"
    },

    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}

